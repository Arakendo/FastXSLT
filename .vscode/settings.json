{
  "editor.formatOnSave": true,
  "files.eol": "\n",
  "git.detectSubmodules": false,
  "git.ignoredRepositories": [
    "vendor/xslt30-test",
    "vendor/qt3tests"
  ],
  "search.exclude": {
    "vendor/**": true
  },
  "files.watcherExclude": {
    "**/vendor/**": true
  },
